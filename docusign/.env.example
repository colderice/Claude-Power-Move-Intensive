# Server
PORT=3000
BASE_URL=http://localhost:3000

# JWT Secret (change this to a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret-string

# Admin Account (created on first run)
ADMIN_EMAIL=john@3rdpoweroutlet.com
ADMIN_NAME=John
ADMIN_PASSWORD=changeme123

# Organization Name (shown in emails and PDFs)
ORG_NAME=3rd Power Outlet
ORG_EMAIL=john@3rdpoweroutlet.com

# Email / SMTP Settings
# For Gmail: use your Gmail address and an App Password (not your regular password)
# To get App Password: Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# If you want to use a different "From" address
EMAIL_FROM="3rd Power Outlet <john@3rdpoweroutlet.com>"
